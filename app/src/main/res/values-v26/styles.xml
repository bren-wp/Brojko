<resources>
    <!-- API 26: runtime WindowInsetsControllerCompat selects the icon contrast.
         The windowLightNavigationBar theme attribute starts at API 27. -->
    <style name="Theme.Brojko" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF7A5B</item>
        <item name="android:windowBackground">#FFF8EE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>